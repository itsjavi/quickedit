<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>QuickEdit Text Thumbnail</string>
	<key>CFBundleExecutable</key>
	<string>QuickEditThumbnail</string>
	<!-- scripts/build-app.sh sets the identifier (<app bundle id>.thumbnail) and the version keys from the app's. -->
	<key>CFBundleIdentifier</key>
	<string>com.itsjavi.quickedit.thumbnail</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>QuickEditThumbnail</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0</string>
	<key>CFBundleSupportedPlatforms</key>
	<array>
		<string>MacOSX</string>
	</array>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Javi Aguilar</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- Text types without a system text preview or thumbnail (decision-5). Keep in sync with Info.plist (the preview). -->
			<key>QLSupportedContentTypes</key>
			<array>
				<!-- .ts: TypeScript sources share it with MPEG-2 transport stream video. -->
				<string>public.mpeg-2-transport-stream</string>
				<!-- System types conforming only to public.text, which the built-in text preview skips. -->
				<string>public.yaml</string>
				<string>com.itsjavi.quickedit.yaml-variant</string>
				<string>public.toml</string>
				<string>public.css</string>
				<!-- Lumiose components, declared in the app's Info.plist. -->
				<string>com.itsjavi.lumiose.stsx</string>
				<string>com.itsjavi.lumiose.sjsx</string>
			</array>
			<!-- Icons of every size show content, as the system does for plain text. -->
			<key>QLThumbnailMinimumDimension</key>
			<integer>0</integer>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.quicklook.thumbnail</string>
		<key>NSExtensionPrincipalClass</key>
		<string>QuickEditThumbnail.ThumbnailProvider</string>
	</dict>
</dict>
</plist>
