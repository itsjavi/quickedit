; QuickEdit diff highlights (replaces upstream: whole lines for additions/deletions, headers as meta).

(comment) @comment

[
  (addition)
  (new_file)
] @diff.plus

[
  (deletion)
  (old_file)
] @diff.minus

(change) @diff.delta

[
  (command)
  (index)
  (location)
  (similarity)
  (dissimilarity)
  (file_change)
  (binary_change)
] @diff.meta

(commit) @constant
